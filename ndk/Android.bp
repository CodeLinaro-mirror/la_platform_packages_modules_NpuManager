// /system                                      |  /apex/com.android.npumanager
//  +---------------------------------------+   |
//  | libandroid.so                         |   |
//  |  +-----------------------------------+|   |
//  |  | libandroid_com.android.npumanager || <-+-> libcom.android.npumanager.so
//  |  +-----------------------------------+|   |
//  +---------------------------------------+   |

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_machine_learning",
}

ndk_headers {
    name: "libnpumanager_ndk_headers",
    from: "include/android",
    to: "android",
    srcs: ["include/android/**/*.h"],
    license: "NOTICE",
}

rust_bindgen {
    name: "libnpumanager_bindings",
    wrapper_src: "include/android/npumanager/buffer.h",
    crate_name: "npumanager_bindings",
    source_stem: "bindings",
    bindgen_flags: [
        "--allowlist-type=ANpuBuffer_Priority",
        "--allowlist-type=ANpuBuffer_Type",
        "--allowlist-type=ANpuManager_AllocCallback",
        "--allowlist-type=ANpuManager_PreemptCallback",
        "--allowlist-type=ANpuManager_CookieDeleter",
    ],
    apex_available: ["com.android.npumanager"],
    min_sdk_version: "apex_inherit",
}

rust_ffi_static {
    name: "libnpumanager_rust",
    crate_name: "npumanager",
    export_include_dirs: [
        "include",
    ],
    crate_root: "buffer_impl.rs",
    srcs: [
        "*.rs",
    ],
    rustlibs: [
        "libbinder_rs",
        "liberrno",
        "libnpumanager_bindings",
        "liblibc",
    ],
    apex_available: ["com.android.npumanager"],
    min_sdk_version: "apex_inherit",
}

cc_library_shared {
    name: "libcom.android.npumanager",
    whole_static_libs: ["libnpumanager_rust"],
    export_static_lib_headers: ["libnpumanager_rust"],
    apex_available: ["com.android.npumanager"],
    min_sdk_version: "apex_inherit",
    stubs: {
        symbol_file: "libcom.android.npumanager.map.txt",
    },
    ldflags: [
        // TODO: b/476223845 - Remove this flag once the bug is fixed.
        "-Wl,--strip-all",
    ],
}

cc_library_static {
    name: "libandroid_com.android.npumanager",
    srcs: ["libandroid_shim.cpp"],
    cflags: [
        "-Wall",
        "-Werror",
    ],
    local_include_dirs: [
        "include",
        "include_libandroid",
    ],
    export_include_dirs: [
        "include",
    ],
    shared_libs: [
        "libcom.android.npumanager",
    ],
    visibility: ["//frameworks/base/native/android:__pkg__"],
}
