package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

filegroup {
    name: "service-npumanager-sources",
    srcs: [
        "java/**/*.java",
    ],
    path: "java",
}

java_library {
    name: "service-npumanager",
    permitted_packages: [
        "com.android.server.npumanager",
        "com.android.npumanager",
        "android.hardware.npu",
    ],
    srcs: [":service-npumanager-sources"],
    sdk_version: "core_platform",
    min_sdk_version: "36",
    platform_apis: false,
    defaults: [
        "framework-system-server-module-defaults",
        "framework-system-server-module-optimize-defaults",
    ],
    apex_available: ["com.android.npumanager"],
    libs: [
        "framework-npumanager.stubs",
        "framework-npumanager.stubs.system",
        "framework-npumanager.impl",
        "services.core",
        "framework",
        "android_system_stubs_current",
    ],
    static_libs: [
        "npumanager_flags_lib",
        "android.hardware.npu-V1-java",
    ],
    installable: true,
    errorprone: {
        extra_check_modules: [
            "//external/nullaway:nullaway_plugin",
        ],
        javacflags: [
            "-Xep:NullAway:ERROR",
            "-XepOpt:NullAway:AnnotatedPackages=com.android.server.npumanager",
        ],
    },
}
