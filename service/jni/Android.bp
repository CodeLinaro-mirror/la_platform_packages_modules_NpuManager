package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_machine_learning",
}

rust_ffi_shared {
    name: "libnpumanager_service_jni",
    crate_name: "npumanager_service_jni",
    crate_root: "lib.rs",
    srcs: [
        "com_android_server_npumanager_NpuAllocator.rs",
        "lib.rs",
    ],
    rustlibs: [
        "libbinder_rs",
        "framework-npumanager-aidl-rust",
        "libbitflags",
        "libjni",
        "liblibc",
        "libprotobuf",
        "libprotobuf_json_mapping",
        "libdma_heap_config_proto_rust",
        "libdma_heap_config_rust",
        "libdmabufheap_rust",
        "liberrno",
        "liblog_rust",
        "libnix",
        "libwrapfd_rust",
    ],
    static_libs: [
        "libdmabufheap",
    ],
    apex_available: ["com.android.npumanager"],
    min_sdk_version: "apex_inherit",
}
