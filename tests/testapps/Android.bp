package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_machine_learning",
}

android_library {
    name: "CtsNpuManagerTestAppLib",
    manifest: "AndroidManifest_testapp.xml",
    srcs: ["src/**/*.java"],
    static_libs: [
        "npumanager-test-utils",
        "compatibility-device-util-axt",
    ],
}

android_test_helper_app {
    name: "CtsNpuManagerTestAppA",
    manifest: "AndroidManifest_A.xml",
    static_libs: ["CtsNpuManagerTestAppLib"],
    package_name: "android.npumanager.testapp.A",
}

android_test_helper_app {
    name: "CtsNpuManagerTestAppB",
    manifest: "AndroidManifest_B.xml",
    static_libs: ["CtsNpuManagerTestAppLib"],
    package_name: "android.npumanager.testapp.B",
}
