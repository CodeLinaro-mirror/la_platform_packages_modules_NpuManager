<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="android.npumanager.testapp">
    <application>
        <activity android:name="android.npumanager.testapp.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".NpuManagerTestService"
            android:enabled="true"
            android:exported="true">
        </service>
    </application>

    <uses-feature android:name="android.hardware.npu" android:required="true"/>
    <uses-permission android:name="android.permission.ACCESS_NPU_MODEL_MANAGER_API" />
</manifest>
