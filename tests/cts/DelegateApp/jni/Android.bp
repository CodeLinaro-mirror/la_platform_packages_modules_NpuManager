package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_library_shared {
    name: "libnnapidelegateappjni",
    relative_install_path: "lib",
    srcs: [
        "nnapi_inference_jni.cpp",
        "nnapi_inference.cpp",
    ],
    local_include_dirs: ["."],
    sdk_version: "current",

    static_libs: [
        "libflatbuffers-cpp",
        "libtflite_static",
    ],
    header_libs: [
        "jni_headers",
        "flatbuffer_headers",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-missing-field-initializers",
    ],
    shared_libs: [
        "liblog",
        "libneuralnetworks",
    ],
    stl: "libc++_static",
    include_dirs: [
        "external/tensorflow",
    ],
    strip: {
        all: true,
    },
}
