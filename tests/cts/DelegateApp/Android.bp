package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

COMMON_SRCS = ["src/**/*.java"]
COMMON_RESOURCE_DIRS = ["res"]
COMMON_STATIC_LIBS = [
    "androidx.test.runner",
    "androidx.test.rules",
    "androidx.test.core",
    "androidx.test.ext.junit",
    "androidx.appcompat_appcompat",
    "mobly-snippet-lib",
    "androidx.startup_startup-runtime",

]
COMMON_JNI_LIBS = ["libnnapidelegateappjni"]

java_defaults {
    name: "NpuTestAppDefaults",
    srcs: COMMON_SRCS,
    libs: ["framework-npumanager.stubs.module_lib"],
    static_libs: COMMON_STATIC_LIBS,
    resource_dirs: COMMON_RESOURCE_DIRS,
    jni_libs: COMMON_JNI_LIBS,
    sdk_version: "test_current",
    min_sdk_version: "35",
    test_suites: ["device-tests"],
}

android_test_helper_app {
    name: "BackgroundNpuTestApp",
    defaults: ["NpuTestAppDefaults"],
    package_name: "com.android.npumanager.delegateapp",
    manifest: "AndroidManifest.xml",
    use_embedded_native_libs: true,
    sdk_version: "test_current",
    min_sdk_version: "35",
}

android_test_helper_app {
    name: "ForegroundNpuTestApp",
    defaults: ["NpuTestAppDefaults"],
    package_name: "com.android.npumanager.delegateapp.foreground",
    manifest: "AndroidManifest_variant.xml",
    use_embedded_native_libs: true,
    sdk_version: "test_current",
    min_sdk_version: "35",
}

android_test_helper_app {
    name: "NoFeatureNpuTestApp",
    defaults: ["NpuTestAppDefaults"],
    package_name: "com.android.npumanager.delegateapp.nofeature",
    manifest: "AndroidManifest_nofeature.xml",
    use_embedded_native_libs: true,
    sdk_version: "test_current",
    min_sdk_version: "35",
}
