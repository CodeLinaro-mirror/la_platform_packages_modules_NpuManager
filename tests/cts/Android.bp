package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_machine_learning",
}

python_defaults {
    name: "CtsNpuManagerPythonDefaults",
    libs: [
        "mobly",
        "platform-test-py-annotations",
    ],
}

python_test_host {
    name: "CtsNpuManagerTestCases",
    main: "cts_npu_manager_test.py",
    srcs: ["cts_npu_manager_test.py"],
    libs: ["mobly"],
    test_config: "AndroidTest.xml",
    test_options: {
        unit_test: false,
        runner: "mobly",
    },
    device_common_data: [
        ":mobly-bundled-snippets",
        ":BackgroundNnapiDelegateApp",
        ":ForegroundNnapiDelegateApp",
    ],

    test_suites: [
        "general-tests",
        "cts",
    ],
}
