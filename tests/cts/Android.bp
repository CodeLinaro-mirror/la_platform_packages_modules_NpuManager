package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_machine_learning",
}

python_test_host {
    name: "CtsNpuManagerMoblyTestCases",
    main: "cts_npu_manager_test.py",
    srcs: ["cts_npu_manager_test.py"],
    libs: [
        "mobly",
        "mobly_device_flags",
        "platform-test-py-annotations",
    ],
    test_config: "AndroidTest.xml",
    test_options: {
        unit_test: false,
        runner: "mobly",
    },
    device_common_data: [
        ":mobly-bundled-snippets",
        ":BackgroundNnapiDelegateApp",
        ":ForegroundNnapiDelegateApp",
    ],

    test_suites: [
        "general-tests",
        "cts",
    ],
}

android_test {
    name: "CtsNpuManagerTestCases",
    team: "trendy_team_machine_learning",
    defaults: ["cts_defaults"],
    libs: [
        "android.test.runner.stubs.system",
        "android.test.base.stubs.system",
        "npumanager_flags_lib",
    ],
    srcs: [
        "src/**/*.java",
    ],
    // Tag this module as a cts test artifact
    test_suites: [
        "cts",
        "general-tests",
    ],
    static_libs: [
        "ctstestrunner-axt",
        "modules-utils-build",
        "testng",
        "flag-junit",
        "compatibility-device-util-axt",
    ],
    min_sdk_version: "36",
    sdk_version: "test_current",

}
