package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

apex_key {
    name: "com.android.npumanager.key",
    public_key: "com.android.npumanager.avbpubkey",
    private_key: "com.android.npumanager.pem",
}

android_app_certificate {
    name: "com.android.npumanager.certificate",
    certificate: "com.android.npumanager",
}

systemserverclasspath_fragment {
    // This fragment will be enabled using RELEASE_NPUMANAGER_MODULE flag
    enabled: select(release_flag("RELEASE_NPUMANAGER_MODULE"), {
        true: true,
        false: false,
    }),

    name: "com.android.npumanager-systemserverclasspath-fragment",
    standalone_contents: ["service-npumanager"],
    apex_available: ["com.android.npumanager"],
}

apex {
    // This apex will be enabled using RELEASE_NPUMANAGER_MODULE flag
    enabled: select(release_flag("RELEASE_NPUMANAGER_MODULE"), {
        true: true,
        false: false,
    }),

    name: "com.android.npumanager",
    manifest: "manifest.json",
    file_contexts: ":com.android.npumanager-file_contexts",
    key: "com.android.npumanager.key",
    certificate: ":com.android.npumanager.certificate",
    defaults: ["b-launched-apex-module"],
    systemserverclasspath_fragments: ["com.android.npumanager-systemserverclasspath-fragment"],
}
